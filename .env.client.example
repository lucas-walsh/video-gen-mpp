# =============================================================================
# Client Environment Configuration
# =============================================================================
# Copy this file to .env.client and fill in your values.
# NEVER commit .env.client with real keys to version control.
# =============================================================================

# -- Client Wallet ------------------------------------------------------------
# WARNING: Private keys grant full control of the wallet. Anyone with this
# key can sign transactions and drain funds. Never share it, commit it to
# git, or reuse a key that holds real funds on mainnet.
#
# Private key for the client's Tempo wallet (hex, without 0x prefix).
# This wallet signs TIP-20 transfer transactions to pay for video generation.
# In MetaMask: Account details > Show private key.
# See docs/tempo-wallet-setup.md for how to create one.
TEMPO_CLIENT_PRIVATE_KEY=your_client_private_key_hex

# -- Server Connection --------------------------------------------------------
# URL of the video generation API server
API_URL=http://localhost:8000

# -- Tempo Blockchain (must match server config) ------------------------------
# Tempo testnet RPC endpoint
RPC_URL=https://rpc.moderato.tempo.xyz

# Tempo Moderato testnet chain ID
TEMPO_CHAIN_ID=42431

# pathUSD TIP-20 token contract address on Tempo testnet
PATHUSD_ADDRESS=0x20c0000000000000000000000000000000000000
