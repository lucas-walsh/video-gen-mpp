# =============================================================================
# Server Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real keys to version control.
# =============================================================================

# -- FAL AI ------------------------------------------------------------------
# API key from https://fal.ai/dashboard/keys
FAL_AI_KEY=your_fal_ai_api_key_here

# FAL queue endpoint (default is correct for most setups)
FAL_QUEUE_BASE_URL=https://queue.fal.run

# -- Tempo Blockchain --------------------------------------------------------
# Server's Tempo wallet private key (hex, without 0x prefix).
# This wallet receives payments and sponsors transaction fees.
# See docs/tempo-wallet-setup.md for how to create one.
SERVER_PRIVATE_KEY=your_server_private_key_hex

# Tempo testnet RPC endpoint
TEMPO_RPC_URL=https://rpc.testnet.tempo.xyz

# Tempo testnet chain ID
TEMPO_CHAIN_ID=57059

# pathUSD TIP-20 token contract address on Tempo testnet
PATHUSD_ADDRESS=0x20c0000000000000000000000000000000000000

# -- MPP (Machine Payments Protocol) -----------------------------------------
# Secret key for HMAC-SHA256 challenge binding.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MPP_SECRET_KEY=your_mpp_secret_key_here

# -- Server -------------------------------------------------------------------
# Host and port for uvicorn
HOST=0.0.0.0
PORT=8000

# Default FAL AI model for video generation
DEFAULT_VIDEO_MODEL=fal-ai/veo3.1/fast
