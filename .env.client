# Client Configuration for MPP Payment Script
# Copy this file to .env and fill in your values

# Client private key for signing transactions
# DO NOT share this key or commit it to version control
CLIENT_PRIVATE_KEY=""

# API URL for the video generation server
API_URL="http://localhost:8000"

# RPC URL (for future use - not needed for current implementation)
# The client signs transactions locally without broadcasting
RPC_URL="https://rpc.testnet.tempo.xyz"

# Chain ID (Tempo testnet)
TEMPO_CHAIN_ID="57059"

# pathUSD token address (Tempo testnet)
PATHUSD_ADDRESS="0x20c0000000000000000000000000000000000000"
