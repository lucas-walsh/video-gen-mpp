# =============================================================================
# Client Environment Configuration
# =============================================================================
# Used by client-pay.py to sign and submit payment transactions.
# =============================================================================

# -- Client Wallet ------------------------------------------------------------
# Private key for the client's Tempo wallet (hex, without 0x prefix).
# This wallet signs TIP-20 transfer transactions to pay for video generation.
# See docs/tempo-wallet-setup.md for how to create one.
CLIENT_PRIVATE_KEY=your_client_private_key_hex

# -- Server Connection --------------------------------------------------------
# URL of the video generation API server
API_URL=http://localhost:8000

# -- Tempo Blockchain (must match server config) ------------------------------
# Tempo testnet RPC endpoint
RPC_URL=https://rpc.testnet.tempo.xyz

# Tempo testnet chain ID
TEMPO_CHAIN_ID=57059

# pathUSD TIP-20 token contract address on Tempo testnet
PATHUSD_ADDRESS=0x20c0000000000000000000000000000000000000
